# Data Napoli — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/

# Pipeline output (frame, PNG, video) — non committare file generati
output/
*.mp4
*.mov

# API keys e segreti
.env
secrets.yaml

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Jupyter
*.ipynb_checkpoints/

# Database locale (generato, non versionato)
*.sqlite
db/*.sqlite
db/*.sqlite-journal
inbox/*
!inbox/.gitkeep
archive/*
!archive/.gitkeep
foto/*
!foto/.gitkeep

# DB e backups
db/backups/
db/*.sqlite-journal

# Wikipedia cache HTML
data/import/wikipedia/cache/

# Node / Web App
node_modules/
dist/
package-lock.json
.tempmediaStorage/
.env.local
*.log

# Scratch, copie temporanee e backup
*_copy.*
scratch_*
*.bak*
*.bak_*
sscnapolidata-remote/

# Notebooks e note scratch
Colab_*.ipynb
blueprint-*.md
prompt-*.md

# Dumps e json intermedi obsoleti
master_database_napoli.json
matches_history.json
names.json
app.js
style.css
favicon.png
fiorentina-napoli-2026-09-20.html

