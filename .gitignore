# Data Napoli — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/

# Pipeline output (frame, PNG, video) — non committare file generati
output/
*.mp4
*.mov

# API keys e segreti
.env
secrets.yaml

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Jupyter
*.ipynb_checkpoints/

# Database locale (generato, non versionato)
db/*.sqlite
db/*.sqlite-journal
inbox/*
!inbox/.gitkeep
archive/*
!archive/.gitkeep
foto/*
!foto/.gitkeep
